# ── Trading Mode ─────────────────────────────────────────────
# dry-run: no real orders (safe for testing)
# paper: paper trading with real market data (fake capital)
# live: REAL money — requires QUALITY_GATE_PASSED=true
TRADING_MODE=dry-run

# ── Binance API Keys ─────────────────────────────────────────
# Get from: https://www.binance.com/en/my/settings/api-management
# For testnet: https://testnet.binancefuture.com/
# IMPORTANT: DO NOT enable Withdrawal permission!
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_TESTNET=true       # true = testnet (safe), false = mainnet (real money)
BINANCE_HEDGE_MODE=true    # true = Hedge Mode (long + short simultaneously)

# ── Capital & Risk ────────────────────────────────────────────
PAPER_CAPITAL_USDT=10000.0
MAX_RISK_PER_TRADE_PCT=0.02      # 2% per trade
MAX_DAILY_LOSS_PCT=0.08          # 8% daily loss limit
MAX_WEEKLY_LOSS_PCT=0.15         # 15% weekly loss limit
MAX_DRAWDOWN_PCT=0.30            # 30% max drawdown
MAX_LEVERAGE_CAP=10              # 10x hard cap
MAX_CONCURRENT_POSITIONS=3
MAX_TOTAL_EXPOSURE_PCT=0.75
MAX_SINGLE_EXPOSURE_PCT=0.30

# ── Signal Settings ───────────────────────────────────────────
SIGNAL_ENTRY_THRESHOLD=0.42
SIGNAL_EXIT_THRESHOLD=0.35
SIGNAL_TIMEFRAME=5               # 5-minute candles
TREND_TIMEFRAME=60               # 1-hour for regime detection
TOP_N_COINS=10

# ── Trade Mode Parameters ─────────────────────────────────────
SCALP_STOP_ATR=1.0
SCALP_TP1_ATR=1.5
SCALP_TP2_ATR=3.0
SCALP_MAX_BARS=12
SCALP_PARTIAL_EXIT_PCT=0.60

TREND_STOP_ATR=2.0
TREND_TP1_ATR=3.0
TREND_TP2_ATR=6.0
TREND_MAX_BARS=120
TREND_PARTIAL_EXIT_PCT=0.40
TREND_RIDE_SCORE_THRESHOLD=2

# ── Signal Quality Filters ────────────────────────────────────
SIGNAL_FILTER_ER_THRESHOLD=0.06
SIGNAL_FILTER_HURST_MIN=0.40
SIGNAL_FILTER_MIN_ATR_PCT=0.001

# ── Quality Gate (Backtest Validation) ───────────────────────
# Set QUALITY_GATE_PASSED=true ONLY after backtest passes all criteria
QUALITY_GATE_PASSED=false
QUALITY_GATE_SHARPE=1.0
QUALITY_GATE_MDD=0.30
QUALITY_GATE_WIN_RATE=0.45
QUALITY_GATE_PROFIT_FACTOR=1.5
QUALITY_GATE_MIN_TRADES=100

# ── Backtest ─────────────────────────────────────────────────
BACKTEST_START=2024-01-01
BACKTEST_END=2024-12-31
BACKTEST_FEE_TAKER=0.0004        # Binance taker 0.04%
BACKTEST_FEE_MAKER=0.0002        # Binance maker 0.02%
BACKTEST_SLIPPAGE_PCT=0.0002
BACKTEST_INITIAL_CAPITAL=10000.0

# ── Macro Regime (Market Mode Switching) ─────────────────
# BULL market: multi-coin, MAX_LEVERAGE_CAP (10×)
# BEAR/SIDEWAYS: BTC+ETH only, BEAR_MAX_LEVERAGE_CAP (50×)
BULL_MODE_SYMBOLS=                          # empty = auto (TOP_N_COINS)
BEAR_MODE_SYMBOLS=BTCUSDT,ETHUSDT
BEAR_MAX_LEVERAGE_CAP=50
MACRO_REGIME_CHECK_HOURS=4                  # check interval in hours
MACRO_BULL_CONFIRM_COUNT=3                  # consecutive BULL signals to switch
MACRO_BEAR_CONFIRM_COUNT=2                  # consecutive BEAR signals to switch

# ── Profit Protection ─────────────────────────────────────────
PROFIT_PROTECT_ENABLED=true
PROFIT_PROTECT_THRESHOLD_PCT=0.20
PROFIT_PROTECT_TRANSFER_PCT=0.20    # 20%만 이체, 80% 복리 재투자
PROFIT_PROTECT_MIN_CAPITAL_PCT=1.10
PROFIT_PROTECT_CHECK_HOURS=24
PROFIT_PROTECT_MIN_EQUITY_USDT=10000.0  # 이 금액 이상일 때만 이체 (복리 성장 보호)

# ── Slack Notifications ───────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
SLACK_DAILY_REPORT_HOUR=9        # KST 09:00 (+ every 4 hours)
SLACK_DASHBOARD_INTERVAL_MINUTES=120

# Slack Bot (Socket Mode) — for /dashboard, /positions, /pnl, /status commands
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...

# ── Database ──────────────────────────────────────────────────
DATABASE_PATH=/data/bot.db       # Docker volume path

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs
